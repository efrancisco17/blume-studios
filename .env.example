# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail address (for "From" field)
GMAIL_ADDRESS=your-email@gmail.com

# Google OAuth (for Gmail & Calendar)
# Create these at https://console.cloud.google.com/
# Redirect URI: http://localhost:3001/api/auth/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Google Places API (for prospecting)
# Enable at https://console.cloud.google.com/
# Can use same project as Google OAuth
GOOGLE_PLACES_API_KEY=...

# Backend server
PORT=3001
NODE_ENV=development
